# Environment variables for docker-compose.
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# NOTE: for native development (running `go run ./cmd/server` on the host),
# copy this file to backend/.env instead — godotenv reads .env from the
# current working directory, and migrations are resolved relative to it too.
# See docs/local-development.md.

# --- Database (used by docker-compose) ---
DB_USER=yearbook
DB_PASSWORD=your-secure-password-here
DB_NAME=yearbook
DB_PORT=5434

# --- Backend ---
ENVIRONMENT=production
API_PORT=8081
JWT_SECRET=your-jwt-secret-min-32-chars
LOG_LEVEL=info
# JWT_ACCESS_EXPIRY_MINUTES=15
# JWT_REFRESH_EXPIRY_DAYS=7

# --- Frontend ---
FRONTEND_PORT=3001

# --- Immich (required for flipbook pages) ---
# Must be reachable from wherever the app runs. Pages come from an Immich
# album named "Thamrin Graduate <year>".
IMMICH_URL=http://192.168.88.103:2283
IMMICH_API_KEY=

# --- Native development only ---
# Used when running the backend on the host instead of in Docker.
# DATABASE_URL=postgres://yearbook:your-secure-password-here@localhost:5434/yearbook?sslmode=disable
# MIGRATIONS_DIR=migrations
