# Server
ENVIRONMENT=development
PORT=8080

# Database
DATABASE_URL=postgres://postgres:***@localhost:5432/yearbook?sslmode=disable

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ISSUER=digital-yearbook
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFIRY_DAYS=7

# CORS
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_PROD=https://yearbook.client.arjism.com

# Storage (Immich)
IMMICH_URL=http://immich_server:2283
IMMICH_API_KEY=your-immich-api-key

# Logging
LOG_LEVEL=info
